<?php
/* ===================================================================
   mon.php — BẢN VÁ SẴN, chép đè lên mon.php trên server.

   ⚠️ TRƯỚC KHI UPLOAD: mở mon.php hiện tại trên server, copy 3 giá trị
   kết nối DB và thay vào ___TEN_DATABASE___ / ___TEN_USER___ /
   ___MAT_KHAU___ bên dưới. File này để trong repo nên cố ý KHÔNG chứa
   mật khẩu thật.

   Cần thêm: thư mục php-patch/ (có seo-slug.php) đặt cạnh mon.php,
   và 2 dòng RewriteRule trong .htaccess (xem README.md).
=================================================================== */
/* ===================================================================
   mon.php — Server-rendered Open Graph + schema cho trang chi tiết món.

   Bot Facebook/Zalo/Google không chạy JS → cần render sẵn og:* + schema
   phía server. Phần thân trang vẫn do mon.html + mon.js dựng như cũ.
   An toàn: thiếu id / lỗi DB / không tìm thấy → trả nguyên mon.html.
=================================================================== */

require_once __DIR__ . '/php-patch/seo-slug.php';

$SITE        = 'https://bunquayphuquoc.com';
$DEFAULT_IMG = $SITE . '/uploads/img_b37e910f635ce8da.jpg';
$htmlPath    = __DIR__ . '/mon.html';

$html = @file_get_contents($htmlPath);
if ($html === false) { http_response_code(500); echo 'Not found'; exit; }

header('Content-Type: text/html; charset=utf-8');

$id   = isset($_GET['id'])   ? trim((string)$_GET['id'])   : '';
$slug = isset($_GET['slug']) ? trim((string)$_GET['slug']) : '';
$item = null;
$variants = [];

if ($id !== '' || $slug !== '') {
    try {
        $pdo = new PDO(
            'mysql:host=localhost;dbname=___TEN_DATABASE___;charset=utf8mb4',
            '___TEN_USER___', '___MAT_KHAU___',
            [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
        );
        // Đọc cả thực đơn: cần để tra theo slug và để gom biến thể.
        $rows = $pdo->query('SELECT data FROM menu ORDER BY sort_order ASC')->fetchAll(PDO::FETCH_ASSOC);
        $menu = [];
        foreach ($rows as $r) {
            $d = json_decode($r['data'], true);
            if (is_array($d)) $menu[] = $d;
        }
        $item = bq_menu_find($menu, $slug, $id);
        if ($item) $variants = bq_menu_variants($menu, $item);
    } catch (Throwable $e) {
        $item = null;
    }
}

/* Vào bằng URL cũ (/mon?id=... hoặc slug cũ) -> 301 sang URL chuẩn của
   SẢN PHẨM. Điều kiện so sánh cũng là chốt chặn lặp vô hạn: đang ở đúng
   URL chuẩn thì hai vế bằng nhau nên không redirect nữa. */
if ($item && bq_slugify($slug) !== bq_menu_slug($item)) {
    header('Location: ' . bq_menu_url($item), true, 301);
    exit;
}

// Slug/id sai -> trả 404 thật, đừng trả 200 cho trang rỗng.
if (!$item && ($id !== '' || $slug !== '')) {
    http_response_code(404);
}

if ($item) {
    $siteName = 'Bún Quậy Như Ý';
    $isMulti = !empty($variants) && count($variants) > 1;
    $productName = bq_product_name($item);
    $title = bq_menu_seo_title($item, $siteName);
    $desc  = bq_menu_seo_desc($item);
    if ($desc === '') $desc = $productName . ' — đặc sản tại ' . $siteName . ', Phú Quốc.';
    $emoji = trim($item['emoji'] ?? '');
    $url   = bq_menu_abs_url($item);

    $isImg = (bool)preg_match('#^(https?://|data:|/)#', $emoji)
          || (bool)preg_match('#\.(jpe?g|png|webp|gif)$#i', $emoji);
    $img = $isImg ? (preg_match('#^(https?:|data:)#', $emoji) ? $emoji : $SITE . $emoji) : $DEFAULT_IMG;

    $priceNum = preg_replace('/\D/', '', (string)($item['price'] ?? ''));

    $setAttr = function ($html, $id, $attr, $value) {
        $val = htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
        $re  = '/(id="' . preg_quote($id, '/') . '"[^>]*\b' . $attr . '=")[^"]*(")/';
        return preg_replace_callback($re, function ($m) use ($val) { return $m[1] . $val . $m[2]; }, $html, 1);
    };
    $setTitle = function ($html, $value) {
        $val = htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
        return preg_replace_callback('/(<title id="page-title">).*?(<\/title>)/s',
            function ($m) use ($val) { return $m[1] . $val . $m[2]; }, $html, 1);
    };

    $html = $setTitle($html, $title);
    $html = $setAttr($html, 'page-description',    'content', $desc);
    $html = $setAttr($html, 'page-canonical',      'href',    $url);
    $html = $setAttr($html, 'og-title',            'content', $title);
    $html = $setAttr($html, 'og-description',      'content', $desc);
    $html = $setAttr($html, 'og-url',              'content', $url);
    $html = $setAttr($html, 'og-image',            'content', $img);
    $html = $setAttr($html, 'twitter-title',       'content', $title);
    $html = $setAttr($html, 'twitter-description', 'content', $desc);
    $html = $setAttr($html, 'twitter-image',       'content', $img);

    // JSON-LD render sẵn: Product (nhiều biến thể) hoặc MenuItem (món đơn).
    $schema = [
        '@context' => 'https://schema.org',
        '@type'    => $isMulti ? 'Product' : 'MenuItem',
        'name'     => $productName,
        'description' => $desc,
        'url'      => $url,
        'image'    => $img,
    ];
    if ($isMulti) {
        $offers = [];
        foreach ($variants as $v) {
            $p = preg_replace('/\D/', '', (string)($v['price'] ?? ''));
            $o = ['@type' => 'Offer', 'priceCurrency' => 'VND', 'availability' => 'https://schema.org/InStock'];
            if ($p !== '') $o['price'] = $p;
            $vn = trim($v['name'] ?? '');
            if ($vn !== '') $o['name'] = $vn;
            $offers[] = $o;
        }
        if ($offers) $schema['offers'] = $offers;
    } elseif ($priceNum !== '') {
        $schema['offers'] = ['@type' => 'Offer', 'price' => $priceNum, 'priceCurrency' => 'VND', 'availability' => 'https://schema.org/InStock'];
    }
    $schemaJson = json_encode($schema, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    $html = preg_replace(
        '/(<script type="application\/ld\+json" id="mon-schema">).*?(<\/script>)/s',
        '$1' . str_replace('$', '\\$', $schemaJson) . '$2',
        $html, 1
    );
}

echo $html;
