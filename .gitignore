# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local assistant/tooling notes
.claude/
note.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Sensitive: production secrets & customer data (do NOT commit) ──
# All static-site PHP files embed the live MariaDB password (+ Zalo bot token / cron secret in api.php)
/static-site/*.php
# Runtime data: admin password hash (users.json) + customer bookings/PII (reservations.json) + content
/data/
# Deploy guide prints CRON_SECRET and DB-credential notes
/HUONG-DAN-DEPLOY.md
# Patch/deploy archives (have leaked live DB pass + Zalo token in the past)
*.zip
# Office license / anti-crack tooling (license keys, crack reports) — unrelated to the web project
/license-tool/
/KiemTraCrack.bat
# Real .htaccess embeds the cPanel account name in a log path — keep it local only.
# A sanitized copy is committed as static-site/.htaccess.example
/static-site/.htaccess
